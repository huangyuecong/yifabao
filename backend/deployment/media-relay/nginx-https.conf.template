# Replace __PUBLIC_IP__ with the server public IP before use.
# This is an http-scope vhost FILE, not text for a server-only editor.
# Verify /www/server/panel/vhost/nginx/*.conf is included at http scope.
# No existing port 80 or 443 listener is modified.
limit_conn_zone $binary_remote_addr zone=yifabao_media_relay_per_ip:1m;
limit_conn_zone $server_name zone=yifabao_media_relay_total:1m;

server {
    # This must be the only service on 8443, so IP clients without SNI receive
    # this certificate. There is deliberately no default_server on port 443.
    listen 8443 ssl;
    server_name __PUBLIC_IP__;
    ssl_certificate /etc/yifabao-media-certbot/config/live/yifabao-media-__PUBLIC_IP__/fullchain.pem;
    ssl_certificate_key /etc/yifabao-media-certbot/config/live/yifabao-media-__PUBLIC_IP__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:YifabaoMediaTLS:5m;
    ssl_session_timeout 10m;

    # Signed download URLs are credentials. Never log their query strings.
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 200m;
    client_body_timeout 180s;
    send_timeout 180s;
    limit_conn yifabao_media_relay_per_ip 4;
    limit_conn yifabao_media_relay_total 8;
    limit_conn_status 429;
    proxy_connect_timeout 10s;
    proxy_send_timeout 180s;
    proxy_read_timeout 180s;
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";

    location = /healthz { proxy_pass http://127.0.0.1:18741; }
    location = /v1/objects { proxy_pass http://127.0.0.1:18741; }
    location ^~ /v1/objects/ { proxy_pass http://127.0.0.1:18741; }
    location = /v1/cleanup { proxy_pass http://127.0.0.1:18741; }
    location ^~ /v1/media/ {
        # Per request; 8 concurrent downloads are approximately 32 Mbit/s.
        limit_rate 512k;
        proxy_pass http://127.0.0.1:18741;
    }
    location / { return 404; }
}
