# Reference-video ingress for an externally hosted content-service.
#
# Replace content.example.cn and the certificate paths.  This location exposes
# only expiring, HMAC-signed provider media URLs; do not proxy the content data
# directory as anonymous static files.

server {
    listen 443 ssl http2;
    server_name content.example.cn;

    ssl_certificate     /etc/nginx/tls/content.example.cn/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/content.example.cn/privkey.pem;

    # CONTENT_PROVIDER_MEDIA_BASE_URL must be:
    # https://content.example.cn/api/v1/provider-media
    location ^~ /api/v1/provider-media/ {
        # Signed URLs contain bearer credentials in their query string.
        access_log off;
        proxy_cache off;
        proxy_buffering off;

        # GET also permits HEAD in nginx's limit_except handling.
        limit_except GET {
            deny all;
        }

        # Keep the original path and signed query string. Range/If-Range are
        # forwarded explicitly because providers may probe or stream the MP4.
        proxy_pass http://content-service:8002;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;

        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
