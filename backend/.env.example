# Content service
CONTENT_DATA_DIR=.data/content
CONTENT_DATABASE_URL=sqlite:///.data/content/content.db
# Optional Dameng (DM8): set CONTENT_DATABASE_BACKEND=dm and a dm+dmPython:// URL.
CONTENT_DATABASE_BACKEND=sqlite
CONTENT_CORS_ORIGINS=http://127.0.0.1:8200,http://localhost:8200,http://127.0.0.1:5173,http://localhost:5173

# Seed 广告法禁用词/敏感词 once for a new rule catalog; deleted rules stay deleted.
CONTENT_SEED_ADVERTISING_LAW=true

# One Ark key authenticates text, image, and AI-video calls. Per-provider keys
# below are optional overrides for deployments that require key isolation.
CONTENT_ARK_API_KEY=
CONTENT_ARK_API_KEY_FILE=

# Content text model. Blank selects Ark when the unified key exists, otherwise mock.
CONTENT_LLM_PROVIDER=
CONTENT_LLM_PROVIDER_ID=
CONTENT_LLM_BASE_URL=
CONTENT_LLM_API_KEY=
CONTENT_LLM_API_KEY_FILE=
CONTENT_LLM_MODEL=
CONTENT_LLM_FALLBACK_MODEL=
CONTENT_LLM_TIMEOUT_SECONDS=120
CONTENT_LLM_MAX_OUTPUT_TOKENS=4000
CONTENT_LLM_TEMPERATURE=0.2
# AI 对话：逐段流式输出回复（SSE），并由模型通过 Function Calling 选择工具；false 时分别改为完整回复、规则路由
CONTENT_CHAT_STREAMING=true
CONTENT_CHAT_TOOL_ROUTING=true
CONTENT_LLM_MAX_ATTEMPTS=2

# Content image generation follows the same unified-key selection rule.
CONTENT_IMAGE_PROVIDER=
CONTENT_IMAGE_PROVIDER_ID=
CONTENT_IMAGE_BASE_URL=
CONTENT_IMAGE_API_KEY=
CONTENT_IMAGE_API_KEY_FILE=
CONTENT_IMAGE_MODEL=
CONTENT_IMAGE_TIMEOUT_SECONDS=180
CONTENT_IMAGE_MAX_CANDIDATES=4
# Comma-separated model capabilities; leave empty instead of copying Demo values.
CONTENT_IMAGE_SUPPORTED_SIZES=
CONTENT_IMAGE_SUPPORTED_RATIOS=

# Content speech synthesis. The new Speech API key is independent from the Ark API key.
# Leave PROVIDER empty to select volcengine_tts_api_key when CONTENT_SPEECH_API_KEY exists.
# Use CONTENT_SPEECH_PROVIDER=chat-tts for the OpenAI-compatible chat-tts model alias.
CONTENT_SPEECH_PROVIDER=
CONTENT_SPEECH_PROVIDER_ID=
CONTENT_SPEECH_BASE_URL=
CONTENT_SPEECH_API_KEY=
CONTENT_SPEECH_API_KEY_FILE=
# Legacy AppID/Access Token fields are only used with CONTENT_SPEECH_PROVIDER=volcengine_tts.
CONTENT_SPEECH_APP_ID=
CONTENT_SPEECH_ACCESS_TOKEN=
CONTENT_SPEECH_ACCESS_TOKEN_FILE=
CONTENT_SPEECH_RESOURCE_ID=
CONTENT_SPEECH_CLUSTER=volcano_tts
CONTENT_SPEECH_VOICE_TYPE=
# Comma-separated additional Speaker IDs. API-Key mode merges them with the built-in
# public list and removes duplicates, so one configured default does not hide other voices.
CONTENT_SPEECH_SUPPORTED_VOICES=
CONTENT_SPEECH_TIMEOUT_SECONDS=180

# Instrumental BGM only, not standalone sound effects or text-to-speech.
# Without music credentials, generation shows a configuration message (no fake audio).
# Explicit mock is for development/tests only. Ark bearer keys cannot sign GenBGM.
CONTENT_MUSIC_PROVIDER=
CONTENT_MUSIC_PROVIDER_ID=
CONTENT_MUSIC_BASE_URL=
CONTENT_MUSIC_API_KEY=
CONTENT_MUSIC_API_KEY_FILE=
# Volcengine Imagination credentials; obtain/activate independently of Ark.
CONTENT_MUSIC_ACCESS_KEY=
CONTENT_MUSIC_ACCESS_KEY_FILE=
CONTENT_MUSIC_SECRET_KEY=
CONTENT_MUSIC_SECRET_KEY_FILE=
# prepaid -> GenBGM; postpaid -> GenBGMForTime (must already be enabled by administrator).
CONTENT_MUSIC_BILLING=prepaid
CONTENT_MUSIC_POLL_INTERVAL_SECONDS=10
CONTENT_MUSIC_MODEL=
CONTENT_MUSIC_TIMEOUT_SECONDS=300
CONTENT_MUSIC_MAX_BYTES=67108864
# MiniMax accepts hex/url; Volcengine always downloads its result URL immediately.
# Optionally replace the provider's built-in CDN allowlist with comma-separated hosts.
CONTENT_MUSIC_RESPONSE_FORMAT=hex
CONTENT_MUSIC_ALLOWED_DOWNLOAD_HOSTS=
# Unset CONTENT_MUSIC_MIN_DURATION_SECONDS / CONTENT_MUSIC_MAX_DURATION_SECONDS
# uses upstream defaults: Volcengine 30–120 seconds; MiniMax/mock 1–300.
# Volcengine UI accepts 1–120s: shorter music is generated at the upstream minimum
# then trimmed locally. Billing may still follow that upstream generated duration.
# If overriding them, keep the Volcengine upstream interval within 30–120.

# Subtitle defaults are deployment configuration, not Demo acceptance criteria.
CONTENT_SUBTITLE_MAX_CHARS_PER_LINE=24
CONTENT_SUBTITLE_MAX_LINES=2

# Per-shot AI video generation through an asynchronous provider API.
CONTENT_AI_VIDEO_PROVIDER=
CONTENT_AI_VIDEO_PROVIDER_ID=
CONTENT_AI_VIDEO_BASE_URL=
CONTENT_AI_VIDEO_API_KEY=
CONTENT_AI_VIDEO_API_KEY_FILE=
CONTENT_AI_VIDEO_MODEL=
CONTENT_AI_VIDEO_TIMEOUT_SECONDS=60
CONTENT_AI_VIDEO_POLL_INTERVAL_SECONDS=3
CONTENT_AI_VIDEO_MAX_WAIT_SECONDS=900
# Comma-separated provider capability allow-lists. The built-in Seedance 2.0
# fast model uses conservative official defaults starting at 5 seconds; custom
# models/endpoints must declare their own values here so the editor never
# submits unsupported options. Values below 5 seconds are ignored.
CONTENT_AI_VIDEO_SUPPORTED_DURATIONS=
CONTENT_AI_VIDEO_SUPPORTED_RATIOS=
CONTENT_AI_VIDEO_SUPPORTED_RESOLUTIONS=
# Optional short-lived HTTPS gateway for external models to fetch ProjectAsset
# reference videos. The public URL must route to this service's
# /api/v1/provider-media endpoint; never expose CONTENT_DATA_DIR directly.
# Configure BASE_URL and exactly one SECRET source together. Generate at least
# 32 random bytes and prefer a separately mounted secret file in production.
CONTENT_PROVIDER_MEDIA_BASE_URL=
CONTENT_PROVIDER_MEDIA_SIGNING_SECRET=
CONTENT_PROVIDER_MEDIA_SIGNING_SECRET_FILE=
CONTENT_PROVIDER_MEDIA_URL_TTL_SECONDS=900
# Optional private TOS relay for Seedance reference videos. When configured it
# is preferred over the service gateway above. Configure all required values;
# production should mount credentials through the *_FILE variables.
CONTENT_PROVIDER_MEDIA_TOS_ENDPOINT=
CONTENT_PROVIDER_MEDIA_TOS_REGION=
CONTENT_PROVIDER_MEDIA_TOS_BUCKET=
CONTENT_PROVIDER_MEDIA_TOS_ACCESS_KEY=
CONTENT_PROVIDER_MEDIA_TOS_ACCESS_KEY_FILE=
CONTENT_PROVIDER_MEDIA_TOS_SECRET_KEY=
CONTENT_PROVIDER_MEDIA_TOS_SECRET_KEY_FILE=
CONTENT_PROVIDER_MEDIA_TOS_SECURITY_TOKEN=
CONTENT_PROVIDER_MEDIA_TOS_SECURITY_TOKEN_FILE=
CONTENT_PROVIDER_MEDIA_TOS_KEY_PREFIX=provider-media/reference-videos
CONTENT_PROVIDER_MEDIA_TOS_URL_TTL_SECONDS=900
CONTENT_PROVIDER_MEDIA_TOS_OBJECT_TTL_DAYS=1
CONTENT_PROVIDER_MEDIA_TOS_CONNECT_TIMEOUT_SECONDS=10
CONTENT_PROVIDER_MEDIA_TOS_SOCKET_TIMEOUT_SECONDS=60

# Optional standalone private HTTPS relay on a public server (an IP certificate
# is supported). Configure BASE_URL and exactly one TOKEN source together;
# choose either this relay or TOS, never both. BASE_URL is the HTTPS origin only,
# e.g. https://203.0.113.10:8443, without a path, query or embedded credentials.
# Generate a random token of at least 32 characters and prefer TOKEN_FILE.
# Keep URL_TTL_SECONDS equal to the relay server's MEDIA_RELAY_URL_TTL_SECONDS.
CONTENT_PROVIDER_MEDIA_RELAY_BASE_URL=
CONTENT_PROVIDER_MEDIA_RELAY_TOKEN=
CONTENT_PROVIDER_MEDIA_RELAY_TOKEN_FILE=
CONTENT_PROVIDER_MEDIA_RELAY_URL_TTL_SECONDS=1800

# Deterministic local composition.
CONTENT_FFMPEG_PATH=
CONTENT_FFMPEG_TIMEOUT_SECONDS=600

# Upload protection. Point CONTENT_ANTIVIRUS_COMMAND at clamscan (or a
# ClamAV-compatible executable). Production can fail closed with REQUIRED=true.
CONTENT_ANTIVIRUS_COMMAND=
CONTENT_ANTIVIRUS_TIMEOUT_SECONDS=60
CONTENT_ANTIVIRUS_REQUIRED=false
CONTENT_PROJECT_MEDIA_QUOTA_BYTES=21474836480

# Content knowledge provider. jsonl requires an explicit CONTENT_KNOWLEDGE_DIR.
CONTENT_KNOWLEDGE_PROVIDER=library_db
CONTENT_KNOWLEDGE_TOP_K=4
CONTENT_KNOWLEDGE_NAMESPACE=content-service
CONTENT_KNOWLEDGE_DIR=
# Optional WeKnora API; never use a platform administrator password as the API Key.
CONTENT_WEKNORA_BASE_URL=
CONTENT_WEKNORA_API_KEY=
CONTENT_WEKNORA_API_KEY_FILE=
CONTENT_WEKNORA_KNOWLEDGE_BASE_ID=
CONTENT_WEKNORA_TENANT_ID=
CONTENT_WEKNORA_TIMEOUT_SECONDS=30
CONTENT_WEKNORA_SYNC_ENABLED=false
# Archive supported formal library originals; never includes task-only reference media.
CONTENT_WEKNORA_ORIGINALS_ENABLED=false
CONTENT_WEKNORA_ORIGINALS_MAX_FILE_BYTES=52428800
CONTENT_WEKNORA_SYNC_INTERVAL_SECONDS=30
CONTENT_WEKNORA_ALLOWED_DATA_LEVELS=public,internal

# Production adapters to be supplied by the deployment environment:
# HiAgent model gateway (set both provider switches to "hiagent" to use your
# Seedream/Seedance workspace; mount the secret through *_FILE in prod).
# BASE_URL is the gateway origin, e.g. https://hiagent.example.com:30040.
# OBJECT_STORAGE_PORT: only if the tenant serves generated files on its own port.
HIAGENT_BASE_URL=
HIAGENT_OBJECT_STORAGE_PORT=
HIAGENT_AK=
HIAGENT_AK_FILE=
HIAGENT_SK=
HIAGENT_SK_FILE=
HIAGENT_WORKSPACE_ID=
CONTENT_IMAGE_PROVIDER=hiagent
CONTENT_IMAGE_MODEL=d9k56d4mgqo5afvrboqg
CONTENT_IMAGE_MAX_CANDIDATES=15
CONTENT_AI_VIDEO_PROVIDER=hiagent
# Pro is selected first; the provider falls back to fast when Pro is not granted.
CONTENT_AI_VIDEO_MODEL=d9k53bcmgqo5afvrbok0

# DAMENG_DSN=
# REDIS_URL=
# OBJECT_STORAGE_ENDPOINT=
# Unified entry integration: keep development until the entry gateway is ready.
# signed mode rejects unsigned requests and ignores all X-User-*/X-Roles headers.
CONTENT_IDENTITY_MODE=development
# Local launcher only: no login, fixed local owner, editable model settings.
# Keep disabled for network deployments; binds must remain loopback when enabled.
CONTENT_STANDALONE_MODE=true
# Current Entry also supports Cookie forwarding deployments: session mode requires
# both /api/auth/me and an effective current-user policy from /api/entry/me.
# A directory/catalog response is NOT an authorization decision.
# CONTENT_IDENTITY_MODE=session
# ENTRY_PUBLIC_BASE_URL=https://portal.example.com
# CONTENT_ENTRY_AGENT_KEY=B8
# CONTENT_ENTRY_ACCESS_MODE=policy
# CONTENT_ENTRY_SESSION_BASE_URL=
# CONTENT_ENTRY_SESSION_TIMEOUT_SECONDS=5
# Set a shared secret of at least 32 UTF-8 bytes, preferably through a secret file.
# CONTENT_IDENTITY_SECRET_FILE=/etc/yifabao/content-identity.secret
# CONTENT_IDENTITY_SECRET=
# SDK 20260922 aliases are also accepted; provision on the server, never in frontend.
# XJ_AUTH_GATEWAY_SECRET_FILE=/etc/yifabao/content-identity.secret
# XJ_AUTH_GATEWAY_SECRET=
# Explicit permissions -> local business roles. Default grants no additional roles.
# CONTENT_IDENTITY_PERMISSION_MAP={}
# CONTENT_ENTRY_AGENT_KEY=<key agreed with entry owner>
CONTENT_IDENTITY_SIGNING_INPUT=base64url
CONTENT_IDENTITY_MAX_TTL_SECONDS=60
CONTENT_IDENTITY_CLOCK_SKEW_SECONDS=5
# Default maps ordinary users only; add agreed application roles explicitly.
CONTENT_IDENTITY_ROLE_MAP='{"employee":["user"],"user":["user"]}'
# When false, entry gateway enforces ACL if signed claims omit agent_keys.
# A present agent_keys list is always enforced, even when this option is false.
CONTENT_IDENTITY_REQUIRE_AGENT_KEYS=false

# HiAgent Seedance video-to-audio BGM (isolated from editor video jobs)
# CONTENT_MUSIC_PROVIDER=hiagent_seedance
# CONTENT_MUSIC_MODEL=d9k53bcmgqo5afvrbok0
