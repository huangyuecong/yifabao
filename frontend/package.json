{
  "name": "yifabao-content-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "AI个性化内容智能体独立前端",
  "author": "易发宝团队",
  "scripts": {
    "dev": "vite --mode dev",
    "api:generate:content": "pnpm dlx openapi-typescript@7.8.0 --default-non-nullable false ../backend/contracts/content.openapi.json -o src/api/agent/generated/content.openapi.ts",
    "gen:icons": "node scripts/gen-menu-icons.mjs",
    "dev:dev": "vite --mode dev",
    "dev:test": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "build:dev": "node --max-old-space-size=8192 scripts/build-app.mjs dev",
    "build:test": "node --max-old-space-size=8192 scripts/build-app.mjs test",
    "build:prod": "node --max-old-space-size=8192 scripts/build-app.mjs prod",
    "ts:check": "vue-tsc --noEmit",
    "ts:check:agent": "vue-tsc --noEmit -p tsconfig.agent.json",
    "ts:check:content": "vue-tsc --noEmit -p tsconfig.content.json",
    "lint:agent": "eslint src/api/agent src/views/agent src/router/modules/remaining.ts src/router/modules/contentRoutes.ts scripts/build-app.mjs scripts/verify-agent-boundary.mjs",
    "boundary:agent": "node scripts/verify-agent-boundary.mjs",
    "quality:agent": "pnpm run lint:agent && pnpm run ts:check:agent && pnpm run boundary:agent",
    "serve:dev": "vite preview --mode dev",
    "serve:prod": "vite preview --mode prod",
    "preview": "pnpm build:dev && vite preview",
    "clean": "npx rimraf node_modules",
    "clean:cache": "npx rimraf node_modules/.cache",
    "lint": "eslint \"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,json,md,html,css,scss,sass}\"",
    "lint:fix": "eslint \"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,json,md,html,css,scss,sass}\" --fix",
    "lint:style": "stylelint --fix \"./src/**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "preinstall": "npx only-allow pnpm && pnpm config set registry https://registry.npmmirror.com",
    "postinstall": "npx simple-git-hooks && git config core.hooksPath .git/hooks/ && npx license-checker --summary --out ./licenses.txt",
    "lint:lint-staged": "lint-staged -c "
  },
  "peerDependencies": {
    "@vue/composition-api": "^1.0.0-rc.1",
    "vue": "^2.0.0 || >=3.0.0"
  },
  "peerDependenciesMeta": {
    "@vue/composition-api": {
      "optional": true
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@form-create/designer": "^3.2.6",
    "@form-create/element-ui": "^3.2.11",
    "@iconify/iconify": "^3.1.1",
    "@micro-zoe/micro-app": "1.0.0-rc.18",
    "@module-federation/enhanced": "^0.7.6",
    "@module-federation/vite": "^1.1.6",
    "@vue/composition-api": "^1.7.2",
    "@vueuse/core": "^11.1.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "@webav/av-cliper": "^1.2.8",
    "@zxcvbn-ts/core": "^3.0.4",
    "animate.css": "^4.1.1",
    "await-to-js": "^3.0.0",
    "axios": "^1.7.7",
    "axios-shortcut": "^0.1.3",
    "bpmn-js-token-simulation": "^0.10.0",
    "cropperjs": "^1.6.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "diagram-js": "^14.11.3",
    "driver.js": "^1.3.1",
    "echarts": "^5.5.1",
    "echarts-wordcloud": "^2.1.0",
    "element-plus": "^2.8.4",
    "fast-xml-parser": "^4.5.0",
    "highlight.js": "^11.10.0",
    "interactjs": "^1.10.28",
    "jsencrypt": "^3.3.2",
    "lodash-es": "^4.17.21",
    "markdown-it": "^14.1.0",
    "min-dash": "^4.2.1",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^2.2.4",
    "pinia-plugin-persistedstate": "^4.1.1",
    "qrcode": "^1.5.4",
    "qs": "^6.13.0",
    "sm-crypto": "^0.3.13",
    "steady-xml": "^0.1.0",
    "vue": "^3.5.13",
    "vue-demi": "^0.14.10",
    "vue-dompurify-html": "^5.1.0",
    "vue-i18n": "^10.0.4",
    "vue-router": "^4.4.5",
    "vue-types": "^5.1.3",
    "vuedraggable": "^4.1.0",
    "wavesurfer.js": "^7.12.11",
    "web-storage-cache": "^1.1.1",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@antfu/eslint-config": "latest",
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@eslint/eslintrc": "latest",
    "@iconify/json": "^2.2.257",
    "@iconify/utils": "^3.1.4",
    "@intlify/unplugin-vue-i18n": "^5.2.0",
    "@purge-icons/generated": "^0.9.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.7.5",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.5",
    "@types/qs": "^6.9.16",
    "@unocss/eslint-config": "latest",
    "@unocss/transformer-variant-group": "^0.65.3",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitejs/plugin-vue-jsx": "^4.0.1",
    "autoprefixer": "^10.4.20",
    "caniuse-lite": "1.0.30001810",
    "bpmn-js": "17.11.1",
    "bpmn-js-properties-panel": "5.25.0",
    "case-police": "latest",
    "eslint": "latest",
    "eslint-plugin-financial": "latest",
    "eslint-plugin-format": "latest",
    "eslint-plugin-no-unsanitized": "latest",
    "license-checker": "latest",
    "lint-staged": "latest",
    "npm-deprecated-check": "latest",
    "only-allow": "latest",
    "postcss": "^8.4.47",
    "postcss-html": "^1.7.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.24.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass": "^1.79.4",
    "simple-git-hooks": "latest",
    "terser": "^5.34.1",
    "typescript": "^5.6.2",
    "unocss": "^0.65.3",
    "unplugin-auto-import": "^0.18.3",
    "unplugin-element-plus": "^0.8.0",
    "unplugin-icons": "^0.19.3",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.4.8",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-ejs": "^1.7.0",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-purge-icons": "^0.10.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-top-level-await": "^1.4.4",
    "vue-tsc": "^2.1.6",
    "zhlint": "latest"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit ${1}",
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.md": [
      "case-police --fix",
      "zhlint --fix"
    ],
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,json,md,html,css,scss,sass}": "eslint --cache --fix"
  }
}
