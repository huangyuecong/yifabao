# 标题
VITE_APP_TITLE=易发宝工作台

# 系统编码（登录时随表单提交）
VITE_APP_SYS_CODE=

# 项目本地运行端口号
VITE_PORT=8200

# open 运行 npm run dev 时自动打开浏览器
VITE_OPEN=true

# 租户开关
VITE_APP_TENANT_ENABLE=true

# 验证码的开关
VITE_APP_CAPTCHA_ENABLE=true

# 文档地址的开关
VITE_APP_DOCALERT_ENABLE=true

# 打包路径
VITE_BASE_PATH=/content/
VITE_APP_NAME=/content

# 智能体开发联调开关。正式环境必须保持 false，由超级入口提供身份。
VITE_AGENT_DEV_MODE=false

# 页面、静态资源和内容 API 统一置于 /content/ 下。
VITE_CONTENT_API_URL=/content/api
